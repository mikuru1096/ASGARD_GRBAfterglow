include README.md
include License
include Requirements.txt
include install.py
include install.sh
include install.ps1
recursive-include ASGARD *.py
recursive-include asgard_core *.py
recursive-include asgard_core/data_light_curve *
recursive-include asgard_core/data_spectrum *
recursive-include src *.py *.f90
exclude src/*.pyd
exclude src/*.so
recursive-exclude src *.pyd
recursive-exclude src *.so
recursive-exclude * __pycache__ *
recursive-exclude * *.py[cod]
